{
  "name": "neopawn-helper",
  "displayName": "NeoPawn Helper",
  "description": "Полная поддержка NeoPawn и классического Pawn в Visual Studio Code.",
  "version": "1.0.1",
  "publisher": "saintantony",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/fhdev64/neomp-pawn-helper.git"
  },
  "homepage": "https://github.com/fhdev64/neomp-pawn-helper",
  "bugs": {
    "url": "https://github.com/fhdev64/neomp-pawn-helper/issues"
  },
  "keywords": [
    "pawn",
    "neopawn",
    "samp",
    "open.mp",
    "oop",
    "language"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./extension.js",
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:pawn"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pawn",
        "aliases": [
          "NeoPawn",
          "Pawn",
          "pawn"
        ],
        "extensions": [
          ".pwn",
          ".inc",
          ".module"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pawn",
        "scopeName": "source.neopawn",
        "path": "./syntaxes/neopawn.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[pawn]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "neoPawnHelper.reindex",
        "title": "NeoPawn Helper: переиндексировать проект"
      },
      {
        "command": "neoPawnHelper.generateEnumFromCreateTable",
        "title": "NeoPawn Helper: создать enum из CREATE TABLE"
      }
    ],
    "configuration": {
      "title": "NeoPawn Helper",
      "properties": {
        "neoPawnHelper.colors.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Подсвечивать цветовые литералы Pawn и именованные цвета."
        },
        "neoPawnHelper.colors.variables.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Подсвечивать обращения к именованным цветам отдельно от литералов."
        },
        "neoPawnHelper.constants.valueHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Показывать значения простых #define, const и элементов enum прямо в редакторе."
        },
        "neoPawnHelper.definitions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить переход к определениям и поиск ссылок для Pawn и NeoPawn."
        },
        "neoPawnHelper.sql.highlighting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Подсвечивать SQL и спецификаторы mysql_format внутри строк."
        },
        "neoPawnHelper.sql.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Проверять соответствие спецификаторов mysql_format переданным аргументам."
        },
        "neoPawnHelper.index.include": {
          "type": "array",
          "default": [
            "**/*.{pwn,inc,module}"
          ],
          "items": {
            "type": "string"
          },
          "description": "Шаблоны файлов Pawn, которые входят в индекс."
        },
        "neoPawnHelper.index.exclude": {
          "type": "array",
          "default": [
            "**/.git/**",
            "**/.vs/**",
            "**/node_modules/**",
            "**/neomp-pawn-helper/**",
            "**/vscode-pawn-helper/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Шаблоны каталогов и файлов, исключённых из индекса."
        },
        "neoPawnHelper.index.maxFiles": {
          "type": "number",
          "default": 20000,
          "minimum": 100,
          "description": "Максимальное число файлов в индексе."
        },
        "neoPawnHelper.index.debounceMs": {
          "type": "number",
          "default": 1200,
          "minimum": 100,
          "description": "Задержка полной переиндексации после изменения проекта, мс."
        },
        "neoPawnHelper.index.documentDebounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "description": "Задержка обновления индекса открытого документа, мс."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check test/extension.test.js && node --check test/workspace-index.test.js",
    "test": "node test/extension.test.js",
    "package": "npx --yes @vscode/vsce@2.32.0 package --no-dependencies",
    "install:local": "powershell -ExecutionPolicy Bypass -File ./install.ps1"
  }
}
